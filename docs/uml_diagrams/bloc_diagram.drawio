l id="bloc_diagram-16" value="Trạng thái màn hình nằm trong một &lt;b&gt;InvoiceState&lt;/b&gt; bất biến (Equatable): danh sách, bộ lọc tab, từ khóa, trang hiện tại, cờ đang tải, lỗi.&lt;br&gt;Các event khác: InvoiceRefreshRequested, InvoiceTabFilterChanged, InvoiceSearchChanged, InvoiceLoadMoreRequested, InvoicePaymentRecorded, InvoiceRefundRecorded.&lt;br&gt;Các BLoC/Cubit được đăng ký tập trung trong &lt;b&gt;di/injection_container.dart&lt;/b&gt; (GetIt)." style="fontFamily=Helvetica;fontColor=#000000;shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="1990" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>